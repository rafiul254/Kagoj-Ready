# Server-only. Choose a current vision + structured-output model from Google's docs.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional backup vision provider (Groq). Used automatically when Gemini fails or
# is unconfigured. Get a free key at https://console.groq.com (gsk_...).
GROQ_API_KEY=
# Empty = the newest vision-capable model is resolved from Groq's /models at runtime.
GROQ_MODEL=
# Optional third fallback: OpenRouter free vision models, used automatically when
# both Gemini and Groq fail. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Leave all three lines empty to use the built-in free pool (verified 2026-11-04):
# primary google/gemma-4-31b-it:free, then automatic tries on
# nvidia/nemotron-3.5-super-vl:free, google/gemma-4-26b-a4b-it:free and
# dots-studio/dots-3-note-preview:free whenever one is rate-limited (HTTP 429).
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FALLBACK_MODELS=
MODEL_TIMEOUT_MS=22000
# 2200 fits the full 8-field extraction JSON comfortably. If an error ever
# mentions "truncated (finish_reason=length)", raise this to 4096 AND
# DOCUMENT_TOKEN_BUDGET to 20000 in .env.local together.
MODEL_MAX_OUTPUT_TOKENS=2200
DOCUMENT_TOKEN_BUDGET=40000
# Shared limits when Redis is configured; otherwise per-process only.
# A case needs ~1 /api/cases + 1-3 /api/agent calls. Tune DAILY_REQUEST_CAP to your real provider quota.
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_CAP=1500
RULE_STALE_DAYS=90

# Optional shared REST Redis: only opaque budgets / hashed IPs / counters, never document data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Vercel live processing requires shared limits by default. Only override if accepting limitations.
ALLOW_IN_MEMORY_LIMITS=false

# Diagnostic single-sample lab (/lab, /api/samples). Off in production unless true.
ENABLE_LAB=false
