{
  "name": "kagoj-ready",
  "version": "0.3.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:providers": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-providers.ts",
    "eval": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval.ts",
    "eval:mock": "tsx scripts/eval.ts --mock",
    "fixtures": "python scripts/create-fixtures.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "models": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/list-gemini-models.ts"
  },
  "keywords": [],
  "author": "",
  "description": "Evidence-linked, Bangla-first passport preparation with bounded AI and deterministic comparison.",
  "dependencies": {
    "@google/genai": "^2.29.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "picomatch": "^4.0.7"
  }
}
